<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<!-- Sử dụng |DataDirectory| để trỏ tới thư mục chứa file .exe hiện tại -->
		<add name="QLThuVienConn"
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\QLThuVien.mdf;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>